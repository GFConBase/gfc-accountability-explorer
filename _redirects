###############################################
# STANDALONE ETHONLINE REPOSITORY ROUTING
# Canonical public Explorer: explorer.globalfoundationcoin.org/{en,de}/
###############################################

# Host-specific canonical language routes.
https://explorer.globalfoundationcoin.org/      https://explorer.globalfoundationcoin.org/en/  301!
https://explorer.globalfoundationcoin.org/en/  /partials/en/explorer/explorer.html             200!
https://explorer.globalfoundationcoin.org/de/  /partials/de/explorer/explorer.html             200!

# Same-origin read-only Explorer API.
/api/explorer/*      /.netlify/functions/explorer-api?route=:splat       200!

# Canonical language routes for standalone preview/deploys.
/en/index.html       /en/                                             301!
/en/                 /partials/en/explorer/explorer.html               200!
/de/index.html       /de/                                             301!
/de/                 /partials/de/explorer/explorer.html               200!

# Legacy integrated-site Explorer paths redirect to the canonical subdomain.
/en/explorer/index.html  https://explorer.globalfoundationcoin.org/en/  301!
/en/explorer/            https://explorer.globalfoundationcoin.org/en/  301!
/de/explorer/index.html  https://explorer.globalfoundationcoin.org/de/  301!
/de/explorer/            https://explorer.globalfoundationcoin.org/de/  301!

# Standalone deployment root defaults to English.
/                       /partials/en/explorer/explorer.html              200!
