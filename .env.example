# GFC Accountability Explorer — local configuration template
# Copy to .env only on your own machine.
# Never commit real credentials.

# Local server
# Loopback-only by default.
# Set HOST=0.0.0.0 only when your hosting platform explicitly requires an external bind.
HOST=127.0.0.1
PORT=4173

# Data source mode:
# auto  = prefer The Graph when configured, otherwise use the Base Sepolia RPC fallback
# graph = require The Graph; do not silently fall back to RPC
# rpc   = use the Base Sepolia RPC fallback only
DATA_SOURCE_MODE=auto


# ============================================================
# THE GRAPH
# ============================================================

# Development / ETHOnline path
#
# Direct The Graph Studio query endpoint.
# This allows the explorer to consume the deployed Studio subgraph
# without requiring a Graph Network API key.
#
# Example:
# GRAPH_STUDIO_QUERY_URL=https://api.studio.thegraph.com/query/123456/subgraph-name/v0.1.0
#
# Leave empty when using the decentralized Graph Network gateway instead.
GRAPH_STUDIO_QUERY_URL=


# Production / decentralized Graph Network path
#
# Used only when GRAPH_STUDIO_QUERY_URL is empty.
# Do NOT use the Studio deploy key here.
#
# GRAPH_SUBGRAPH_ID:
# Public Graph Network subgraph ID.
#
# GRAPH_API_KEY:
# Server-side query API key.
# Never expose this value in browser/client-side code.
GRAPH_SUBGRAPH_ID=replace_with_deployed_subgraph_id
GRAPH_API_KEY=replace_with_server_side_api_key

# The Graph Network gateway.
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api


# ============================================================
# BASE SEPOLIA RPC FALLBACK
# ============================================================

# Official public Base Sepolia JSON-RPC endpoint.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Recent-window scan controls.
#
# The RPC fallback deliberately provides only a bounded recent
# activity window and MUST NOT be presented as complete history.
RPC_LOOKBACK_BLOCKS=120000
RPC_LOG_CHUNK_BLOCKS=10000
RPC_MAX_ACTIVITY=40


# ============================================================
# EXTERNAL REQUESTS
# ============================================================

# Maximum duration for upstream requests before the server aborts them.
UPSTREAM_TIMEOUT_MS=12000
