# GFC Accountability Explorer — local configuration template
# Copy to .env only on your own machine. Never commit real credentials.

# Local default is loopback-only. Set HOST=0.0.0.0 only when your hosting platform requires an external bind.
HOST=127.0.0.1
PORT=4173
DATA_SOURCE_MODE=auto

# The Graph (server-side only; NOT exposed to browser code)
# Create/deploy the GFC subgraph first, then set both values.
GRAPH_SUBGRAPH_ID=replace_with_deployed_subgraph_id
GRAPH_API_KEY=replace_with_server_side_api_key
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# Base Sepolia live read-only fallback.
# https://sepolia.base.org is the official public Base Sepolia endpoint.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Recent-window scan controls for the RPC fallback.
# The fallback deliberately does not claim to provide complete historical indexing.
RPC_LOOKBACK_BLOCKS=120000
RPC_LOG_CHUNK_BLOCKS=10000
RPC_MAX_ACTIVITY=40

# External requests
UPSTREAM_TIMEOUT_MS=12000
